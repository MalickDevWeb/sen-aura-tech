{
  "version": 2,
  "buildCommand": "vite build && esbuild api/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/index.cjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.cjs" }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.cjs": {
      "maxDuration": 30
    }
  }
}
