{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/[...path].ts": {
      "maxDuration": 30
    },
    "api/auth/verify-pin.ts": {
      "maxDuration": 30
    },
    "api/db/products.ts": {
      "maxDuration": 30
    },
    "api/db/courses.ts": {
      "maxDuration": 30
    },
    "api/db/providers.ts": {
      "maxDuration": 30
    }
  }
}
